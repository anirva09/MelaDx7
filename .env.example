# ---------------------------------------------------------------------------
# MelaDx7 configuration. Copy to `.env` and adjust. Never commit `.env`.
# All variables are read by the backend (pydantic-settings); names are
# case-insensitive. Docker Compose also reads the POSTGRES_* and port values.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development

# Required. At least 32 random characters: `openssl rand -hex 32`
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# --- Database -------------------------------------------------------------
# Local development (Postgres on your machine):
DATABASE_URL=postgresql+asyncpg://lesionlens:lesionlens@localhost:5432/lesionlens
# Docker Compose builds DATABASE_URL from these:
POSTGRES_DB=lesionlens
POSTGRES_USER=lesionlens
POSTGRES_PASSWORD=change-this-database-password

# --- Model ----------------------------------------------------------------
# Directory containing model_card.json + model.pt (relative paths are resolved
# from the repository root). Produced by `python -m ml.training.train`.
MODEL_PATH=models/vit_base_patch16_224-v1.0.0
# Docker Compose mounts ./models at /app/models and loads ./models/$MODEL_DIR
MODEL_DIR=vit_base_patch16_224-v1.0.0
MODEL_DEVICE=cpu
# MODEL_NUM_THREADS=4
MAX_CONCURRENT_INFERENCES=2
# Development only: allow a randomly initialised pipeline-verification model
# (python -m ml.scripts.create_untrained_artifact). Rejected when ENVIRONMENT=production.
ALLOW_UNTRAINED_MODEL=false

# --- Uploads and storage --------------------------------------------------
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_BYTES=10485760
# local | s3
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_PREFIX=lesionlens
# S3_ENDPOINT_URL=          # e.g. http://minio:9000 for MinIO
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# --- HTTP and security ----------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies default to on in production; leave unset unless you know why.
# COOKIE_SECURE=true
# Set to false to allow only admin-created accounts (python -m app.cli create-user).
REGISTRATION_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INFERENCE_PER_MINUTE=30
DOCS_ENABLED=true

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Docker Compose ---------------------------------------------------------
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
